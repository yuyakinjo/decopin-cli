{
  // フォーマットは bun fmt (bun run format) で行う。エディタからは整形しない
  "editor.formatOnSave": false,

  // 保存時にOxlintの安全な修正を適用
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // ファイル監視の設定
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/examples/**": true
  },

  // gitignoreに登録されているフォルダの非表示
  "explorer.excludeGitIgnore": true
}
