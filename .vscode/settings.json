{
  // Oxcをデフォルトフォーマッターに設定
  "editor.defaultFormatter": "oxc.oxc-vscode",

  // 保存時の自動フォーマット
  "editor.formatOnSave": true,

  // 保存時にOxlintの安全な修正を適用
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // ファイル監視の設定
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/examples/**": true
  }
}
