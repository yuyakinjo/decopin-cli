{
  "name": "decopin-cli",
  "version": "2026.903.717",
  "description": "Next.js-like rule-based CLI builder for TypeScript / Bun",
  "keywords": [
    "bun",
    "cli",
    "file-based-routing",
    "framework",
    "jsx",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyakinjo/decopin-cli.git"
  },
  "bin": {
    "decopin": "./src/cli/bin.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx/jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx/jsx-dev-runtime": "./src/jsx/jsx-dev-runtime.ts",
    "./build": "./src/build/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "bun src/cli/bin.ts build",
    "dev": "bun src/cli/bin.ts dev",
    "bench": "bun scripts/benchmark-startup.ts",
    "ci": "bun scripts/ci.tsx",
    "build:package": "bun scripts/build-package.ts",
    "version:next": "bun scripts/next-version.ts"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
