{
  "name": "decopin-cli",
  "version": "0.1.0",
  "description": "Next.js-like rule-based CLI builder for TypeScript / Bun",
  "license": "MIT",
  "bin": {
    "decopin": "./src/cli/bin.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx/jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx/jsx-dev-runtime": "./src/jsx/jsx-dev-runtime.ts",
    "./build": "./src/build/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  }
}
